# taskDataReadiness settings. Copy to .env (optional); start.sh loads it. No secrets are needed for the demo.

# demo        synthetic data + demo identity selector (NOT authentication). Local use only.
# integration demo selector refused; no trusted identity provider is implemented yet, so every check BLOCKS.
TDR_MODE=demo

# fixed:<ISO time with offset> keeps the demo reproducible (the synthetic data is "fresh" at this instant).
# system uses the real clock: the synthetic data will then become stale and checks will BLOCK, as they should.
TDR_CLOCK=fixed:2026-11-14T08:00:00+00:00

# Where profiles and the demo catalog live (defaults: ./profiles and ./catalog).
# TDR_PROFILES_DIR=profiles
# TDR_CATALOG_DIR=catalog

# JSON-lines audit log; set empty to keep audit records in memory only.
TDR_AUDIT_PATH=.data/audit.jsonl

# Port used by start.sh (bound to 127.0.0.1 only).
TDR_PORT=8460

# ./start.sh public: the standalone app on a server's public IP, behind a Caddy container that asks for this login.
# Leave the password empty and the first ./start.sh public generates one here. Change it, then run ./start.sh public again.
# TDR_PUBLIC_PORT=8461
# TDR_PUBLIC_USER=admin
# TDR_PUBLIC_PASSWORD=

# Public demo: visitors confirm their email (6-digit code) before "See it in action"; leads go to .data/leads.jsonl.
# Needs an SMTP account (Gmail: an app password). Owner notifications go to NOTIFY_EMAIL or OWNER_EMAIL.
# TDR_ACCESS_GATE=on
# SMTP_USER=
# SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="Task Data Readiness" <you@gmail.com>
# OWNER_EMAIL=
# NOTIFY_ACCESS=0

# Faulty-dataset lab: originals (never modified) and the working copies fixes are applied to.
# TDR_DATASETS_DIR=datasets
# TDR_DATASETS_WORK_DIR=.data/datasets

# Optional: enables "Ask Claude" in the dashboard (model claude-opus-5-5). Billed to your Anthropic account.
# Keep the real key only in .env (git-ignored), never in this example file.
# ANTHROPIC_API_KEY=
