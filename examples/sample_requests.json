{
  "description": "Labelled demo scenarios. 'expected' is the outcome a human reviewer decided is correct BEFORE running. Used by scripts/run_demo.py and tests/test_api.py. All identities and data are synthetic.",
  "defaults": {
    "transfer_context": {
      "product_id": "SKU-001",
      "origin_warehouse": "WH-A",
      "destination_warehouse": "WH-C",
      "planning_period": "2026-11-16/2026-11-29"
    },
    "identity": {"user": "planner_all", "agent": "scinsight_supervisor"}
  },
  "scenarios": [
    {"name": "identify_transfer", "endpoint": "/tasks/identify",
     "body": {"question": "Should we move SKU 001 from warehouse A to warehouse C?"},
     "expected": {"task_id": "warehouse_transfer", "status": "identified"}},
    {"name": "identify_policy", "endpoint": "/tasks/identify",
     "body": {"question": "What does the supplier policy say about returns?"},
     "expected": {"task_id": "policy_document_qa", "status": "identified"}},
    {"name": "identify_ambiguous_two_tasks", "endpoint": "/tasks/identify",
     "body": {"question": "What does the policy say about how to move stock between warehouses?"},
     "expected": {"task_id": "unknown", "status": "clarification_required"}},
    {"name": "identify_unsupported", "endpoint": "/tasks/identify",
     "body": {"question": "Can you help me with the thing from yesterday?"},
     "expected": {"task_id": "unknown", "status": "clarification_required"}},
    {"name": "identify_explicit_unknown_task", "endpoint": "/tasks/identify",
     "body": {"question": "anything", "task_id": "price_optimisation"},
     "expected": {"task_id": "unknown", "status": "clarification_required"}},

    {"name": "transfer_ready", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity"},
     "expected": {"decision": "READY"}},
    {"name": "transfer_stale_inventory", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "stale_inventory"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_ingestion_time_only", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "inventory_ingestion_time_only"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_missing_warehouse_c", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "missing_warehouse_c"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_user_not_scoped_to_wh_c", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": {"user": "planner_ab", "agent": "scinsight_supervisor"}},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_same_user_within_scope", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": {"product_id": "SKU-001", "origin_warehouse": "WH-A", "destination_warehouse": "WH-B", "planning_period": "2026-11-16/2026-11-29"}, "demo_identity": {"user": "planner_ab", "agent": "scinsight_supervisor"}},
     "expected": {"decision": "READY"}},
    {"name": "transfer_lead_times_unavailable", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "lead_times_unavailable"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_lane_missing", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "missing_lane"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_authorization_unavailable", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "authorization_unavailable"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_catalog_unavailable", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "catalog_unavailable"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_no_identity", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_untrusted_agent", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": {"user": "planner_all", "agent": "untrusted_agent"}},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_no_agent", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": {"user": "planner_all"}},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_wrong_role", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": {"user": "policy_reader", "agent": "scinsight_supervisor"}},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_missing_context", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": {"product_id": "SKU-001", "origin_warehouse": "WH-A", "destination_warehouse": "WH-C"}, "demo_identity": "$identity"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_unknown_product", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": {"product_id": "SKU-999", "origin_warehouse": "WH-A", "destination_warehouse": "WH-C", "planning_period": "2026-11-16/2026-11-29"}, "demo_identity": "$identity"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_period_not_covered", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": {"product_id": "SKU-001", "origin_warehouse": "WH-A", "destination_warehouse": "WH-C", "planning_period": "2027-03-01/2027-03-14"}, "demo_identity": "$identity"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_missing_schema_field", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "inventory_missing_field"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_inventory_missing_owner_blocks", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "inventory_missing_owner"},
     "expected": {"decision": "BLOCKED"}},
    {"name": "transfer_forecast_missing_owner_warns", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "forecast_missing_owner"},
     "expected": {"decision": "READY_WITH_WARNINGS"}},
    {"name": "transfer_forecast_aging_warns", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "demo_identity": "$identity", "demo_scenario": "forecast_aging"},
     "expected": {"decision": "READY_WITH_WARNINGS"}},
    {"name": "unknown_task_profile", "endpoint": "/readiness/check",
     "body": {"task_id": "price_optimisation", "context": {}, "demo_identity": "$identity"},
     "expected": {"status_code": 404, "decision": "BLOCKED", "error_code": "unknown_task_profile"}},
    {"name": "identity_in_body_rejected", "endpoint": "/readiness/check",
     "body": {"task_id": "warehouse_transfer", "context": "$transfer_context", "user_id": "admin", "roles": ["supply_chain_director"]},
     "expected": {"status_code": 422, "decision": "BLOCKED", "error_code": "invalid_request"}},

    {"name": "policy_ready", "endpoint": "/readiness/check",
     "body": {"task_id": "policy_document_qa", "context": {}, "demo_identity": "$identity"},
     "expected": {"decision": "READY"}},
    {"name": "policy_contractor_blocked", "endpoint": "/readiness/check",
     "body": {"task_id": "policy_document_qa", "context": {}, "demo_identity": {"user": "contractor", "agent": "scinsight_supervisor"}},
     "expected": {"decision": "BLOCKED"}},
    {"name": "policy_search_answerable", "endpoint": "/demo/policy/search",
     "body": {"question": "What does the supplier policy say about returns?", "demo_identity": "$identity"},
     "expected": {"decision": "READY", "retriever_called": true, "answerable": true,
                  "hits_include": ["POL-RET-001"], "hits_exclude": ["POL-RET-000", "POL-QA-050", "POL-FIN-900"]}},
    {"name": "policy_search_no_evidence", "endpoint": "/demo/policy/search",
     "body": {"question": "What does the policy say about carbon offsets for air freight?", "demo_identity": "$identity"},
     "expected": {"decision": "READY", "retriever_called": true, "answerable": false}},
    {"name": "policy_search_blocked_does_not_retrieve", "endpoint": "/demo/policy/search",
     "body": {"question": "What does the supplier policy say about returns?", "demo_identity": {"user": "contractor", "agent": "scinsight_supervisor"}},
     "expected": {"decision": "BLOCKED", "retriever_called": false, "answerable": false}},
    {"name": "policy_search_restricted_doc_visible_to_finance", "endpoint": "/demo/policy/search",
     "body": {"question": "What are the supplier payment terms for returns?", "demo_identity": {"user": "finance_controller", "agent": "scinsight_supervisor"}},
     "expected": {"decision": "READY", "retriever_called": true, "hits_include": ["POL-FIN-900"], "hits_exclude": ["POL-RET-001"]}},

    {"name": "evaluate_question_ready", "endpoint": "/evaluate",
     "body": {"question": "Should we move SKU 001 from warehouse A to warehouse C?", "context": {"planning_period": "2026-11-16/2026-11-29"}, "demo_identity": "$identity"},
     "expected": {"decision": "READY"}},
    {"name": "evaluate_ambiguous_stops", "endpoint": "/evaluate",
     "body": {"question": "What does the policy say about how to move stock between warehouses?", "demo_identity": "$identity"},
     "expected": {"decision": "BLOCKED"}}
  ]
}
